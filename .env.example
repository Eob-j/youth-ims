# Copy to .env and fill in. Required values are checked at startup by env.ts.

# Postgres connection string.
DATABASE_URL=

# Better Auth. Generate the secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The public URL of the site. Invite and password reset links use it, so it
# must be the real address in production (e.g. https://doysmoys.gov.gm).
BETTER_AUTH_URL=http://localhost:3000

# Gmail account that sends invite and password reset emails. GMAIL_PASS is a
# Google app password, not the account password.
GMAIL_USER=
GMAIL_PASS=
# Name shown as the sender of those emails.
EMAIL_SENDER_NAME=Youth IMS

# Resend, used only by Better Auth's own email verification.
RESEND_API_KEY=
EMAIL_SENDER_ADDRESS=

# Optional: test accounts for the Playwright tests (pnpm test:e2e). Tests that
# need an account are skipped when it is not set.
# E2E_EMAIL=          # an admin or data_entry user
# E2E_PASSWORD=
# E2E_ADMIN_EMAIL=    # an admin user
# E2E_ADMIN_PASSWORD=
# E2E_VIEWER_EMAIL=   # a viewer user
# E2E_VIEWER_PASSWORD=
